{
  "name": "web-scraper-extension",
  "version": "1.0.1",
  "private": true,
  "description": "Dev tooling for the Web Scraper (ClickScrape) Chrome extension. The extension itself has no build step and no runtime dependencies — this file exists only for the real-browser E2E test harness (e2e/) and its npm scripts.",
  "scripts": {
    "release-check": "node scripts/release-check.js",
    "postinstall": "playwright install chromium",
    "test:browser": "node e2e/run.js",
    "test:browser:headed": "node e2e/run.js --headed",
    "test:browser:autopaginate": "node e2e/run.js --scenario=autopaginate-real-site --headed",
    "test:browser:autoscroll": "node e2e/run.js --scenario=autoscroll-real-site --headed",
    "test:browser:cleaning": "node e2e/run.js --scenario=cleaning-real-site --headed",
    "test:browser:discovery-pagination": "node e2e/run.js --scenario=discovery-pagination-real-site --headed",
    "test:browser:discovery-start-flow": "node e2e/run.js --scenario=discovery-popup-start-real-site --headed",
    "test:browser:discovery-scroll": "node e2e/run.js --scenario=discovery-scroll-real-site --headed",
    "test:browser-safety": "node e2e/browser-ownership-safety-check.js",
    "check-test-infra-safety": "node scripts/check-test-infra-safety.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
