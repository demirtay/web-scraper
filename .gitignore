# Build output (scripts/build-release.js) — reproducible from source, never committed.
dist/

# Personal/internal dev notes — not part of the extension, never published.
Chrome Extension projeler.txt

# npm dev tooling (Playwright, used only by e2e/) — reinstalled via `npm install`.
node_modules/

# Claude Code's own local session/tooling state — not part of the project.
.claude/

# E2E test harness output (screenshots/logs/results) — regenerated by
# `npm run test:browser`, never committed.
test-artifacts/
