# Build output (scripts/build-release.js) — reproducible from source, never committed.
dist/

# Personal/internal dev notes — not part of the extension, never published.
Chrome Extension projeler.txt

# npm dev tooling (Playwright, used only by e2e/) — reinstalled via `npm install`.
node_modules/

# Claude Code's own local session/tooling state — not part of the
# project, EXCEPT the repo-wide Browser Process Safety enforcement below
# (see CLAUDE.md, "## Browser Process Safety — CRITICAL"), which must
# ship WITH the repo so it applies to every future clone/session, not
# just this local checkout.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/*

# E2E test harness output (screenshots/logs/results) — regenerated by
# `npm run test:browser`, never committed.
test-artifacts/
